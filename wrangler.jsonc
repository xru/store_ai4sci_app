{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai4sci-app-store",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",

  "vars": {
    "SITE_NAME": "ai4sci.app — AI for Science App Store",
    "ENVIRONMENT": "development"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai4sci-db",
      "database_id": "[SETUP_REQUIRED: run `npm run db:create` to get the ID]"
    }
  ],

  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "ai4sci-assets"
    }
  ],

  "secrets": [
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "SESSION_SECRET"
  ],

  "routes": [
    { "pattern": "ai4sci.app", "custom_domain": true }
  ],

  "pages_dev": {
    "deployment_branch": "main"
  }
}
